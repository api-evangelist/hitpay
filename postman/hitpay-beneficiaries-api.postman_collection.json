                      "raw": "{\n  \"country\": \"xq\",\n  \"transfer_method\": \"<string>\",\n  \"transfer_type\": \"<string>\",\n  \"currency\": \"<string>\",\n  \"holder_type\": \"individual\",\n  \"bank_swift_code\": \"<string>\"\n}",
