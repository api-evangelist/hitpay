{
  "opencollection": "1.0.0",
  "info": {
    "name": "HitPay Account Status Virtual Accounts API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Virtual Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get virtual accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hit-pay.com/v1/virtual-accounts",
            "headers": [
              {
                "name": "X-BUSINESS-API-KEY",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Cursor for pagination"
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Retrieve the list of virtual accounts for a business. Results are paginated using cursor-based pagination\nand ordered by creation date (newest first).\n"
        },
        {
          "info": {
            "name": "Create a virtual account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.hit-pay.com/v1/virtual-accounts",
            "headers": [
              {
                "name": "X-BUSINESS-API-KEY",
                "value": ""
              }
            ]
          },
          "docs": "Create a new virtual account for the business. The payment provider and method are automatically\ndetermined based on the business configuration.\n\nA business can only have one virtual account per payment provider method. If a virtual account\nalready exists for the same provider method, a 409 Conflict error is returned.\n\nThe business must have payments enabled to create a virtual account.\n"
        },
        {
          "info": {
            "name": "Get virtual account details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hit-pay.com/v1/virtual-accounts/:virtual_account_id",
            "headers": [
              {
                "name": "X-BUSINESS-API-KEY",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "virtual_account_id",
                "value": "",
                "type": "path",
                "description": "The virtual account ID"
              }
            ]
          },
          "docs": "Retrieve detailed information about a specific virtual account.\n"
        }
      ]
    }
  ],
  "bundled": true
}